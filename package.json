{
  "scripts": {
    "build": "nest build",
    "start:ingestion": "nest start ingestion-service --watch",
    "start:analytics": "nest start analytics-service --watch",
    "start:user": "nest start user-service --watch",
    "start:bot": "nest start notification-service --watch",
    "build:all": "nest build ingestion-service && nest build analytics-service && nest build user-service && nest build notification-service",
    "typeorm": "typeorm-ts-node-commonjs -d apps/ingestion-service/src/database/data-source.ts",
    "ingestion:migration:run": "npm run typeorm -- migration:run",
    "ingestion:migration:revert": "npm run typeorm -- migration:revert",
    "ingestion:migration:show": "npm run typeorm -- migration:show",
    "typeorm:user": "typeorm-ts-node-commonjs -d apps/user-service/src/database/data-source.ts",
    "user:migration:run": "npm run typeorm:user -- migration:run",
    "user:migration:revert": "npm run typeorm:user -- migration:revert",
    "user:migration:show": "npm run typeorm:user -- migration:show",
    "prepare": "husky",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\""
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/storage-redis": "^2.6.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "bullmq": "5.81.5",
    "grammy": "^1.46.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
