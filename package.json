    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "bullmq": "^6.4.0",
    "grammy": "^1.46.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
